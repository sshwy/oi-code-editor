  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "dist/types",
    "skipLibCheck": true
  },
  "include": ["src/components/**/*.ts", "src/lib/**/*.ts", "src/components/**/*.vue"]
}

