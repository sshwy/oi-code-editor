{
  "name": "@sshwy/oi-code-editor",
  "version": "0.12.0",
  "homepage": "https://sshwy.github.io/oi-code-editor/",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sshwy/oi-code-editor.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/oi-code-editor.umd.cjs",
  "module": "dist/oi-code-editor.js",
  "types": "dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/oi-code-editor.js",
      "style": "./dist/oi-code-editor.css",
      "require": "./dist/oi-code-editor.umd.cjs"
    }
  },
  "scripts": {
    "build": "vue-tsc -b && vite build --outDir docs-dist",
    "build:lib": "vite build --config vite.config.lib.ts && pnpm build:types",
    "build:types": "vue-tsc -b && tsc-alias -p tsconfig.lib.json",
    "dev": "vite",
    "fmt": "pnpm dlx oxfmt@latest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@babel/runtime": "^8.1.3",
    "@replit/codemirror-vim": "^6.4.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.1.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsc-alias": "^1.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
