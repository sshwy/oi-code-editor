{
  "name": "@sshwy/oi-code-editor",
  "version": "0.5.0",
  "homepage": "https://sshwy.github.io/oi-code-editor/",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sshwy/oi-code-editor.git"
  },
  "style": "dist/oi-code-editor.css",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/oi-code-editor.umd.cjs",
  "module": "dist/oi-code-editor.js",
  "types": "dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/oi-code-editor.js",
      "require": "./dist/oi-code-editor.umd.cjs"
    }
  },
  "scripts": {
    "build": "vue-tsc -b && vite build --outDir docs-dist",
    "build:lib": "vite build --config vite.config.lib.ts && pnpm build:types",
    "build:types": "vue-tsc -b && tsc-alias -p tsconfig.lib.json",
    "dev": "vite",
    "fmt": "pnpm dlx oxfmt@latest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/merge": "^6.11.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.6",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@babel/runtime": "^7.23.0",
    "@replit/codemirror-vim": "^6.3.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.3",
    "@uiw/codemirror-theme-github": "^4.25.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^14.1.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.3.0",
    "vue-tsc": "^3.1.4"
  }
}
